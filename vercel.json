{
  "cleanUrls": true,
  "trailingSlash": true,
  "regions": ["sin1"],
  "git": { "deploymentEnabled": { "main": false } },
  "redirects": [
    { "source": "/\\*", "destination": "/", "statusCode": 301 },
    { "source": "/\\*/", "destination": "/", "statusCode": 301 },
    { "source": "/%2A", "destination": "/", "statusCode": 301 },
    { "source": "/%2A/", "destination": "/", "statusCode": 301 },
    { "source": "/blog/how-ai-is-transforming-future-of-technology/", "destination": "/blog/", "statusCode": 301 },
    { "source": "/blog/ai-sales-automation/", "destination": "/blog/", "statusCode": 301 },
    { "source": "/blog/ai-in-telecom-industry/", "destination": "/blog/", "statusCode": 301 },
    { "source": "/blog/next-interface-shift-ai-native-devices-multimodal-agents/", "destination": "/blog/", "statusCode": 301 },
    { "source": "/blog/why-ai-first-leadership-fails-industrial-businesses/", "destination": "/blog/", "statusCode": 301 },
    { "source": "/blog/category/ai-first-mindset/", "destination": "/blog/", "statusCode": 301 },
    { "source": "/blog/author/:slug/", "destination": "/authors/", "statusCode": 301 },
    { "source": "/blog/page/:n/", "destination": "/blog/", "statusCode": 301 },
    { "source": "/blog/category/:slug/page/:n/", "destination": "/blog/category/:slug/", "statusCode": 301 },
    { "source": "/author-sitemap.xml", "destination": "/sitemap_index.xml", "statusCode": 301 },
    { "source": "/wp-content/uploads/:path*", "destination": "https://djpxdnxnvuokdfxlwktx.supabase.co/storage/v1/object/public/blog-media/wp-content/uploads/:path*", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/about/", "destination": "/api/render-page/?slug=about" },
    { "source": "/blog/", "destination": "/api/blog-index/" },
    { "source": "/feed/", "destination": "/api/feed/" },
    { "source": "/blog/feed/", "destination": "/api/feed/" },
    { "source": "/blog/category/:slug/", "destination": "/api/render-category/?slug=:slug" },
    { "source": "/blog/:slug/", "destination": "/api/render-post/?slug=:slug" },
    { "source": "/sitemap_index.xml", "destination": "/api/sitemap/?kind=index" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap/?kind=index" },
    { "source": "/post-sitemap.xml", "destination": "/api/sitemap/?kind=posts" },
    { "source": "/page-sitemap.xml", "destination": "/api/sitemap/?kind=pages" },
    { "source": "/category-sitemap.xml", "destination": "/api/sitemap/?kind=categories" }
  ]
}
